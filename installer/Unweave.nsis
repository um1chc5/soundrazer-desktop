; Unweave — NSIS installer
;
; Build: makensis Unweave.nsis
;
; This installer intentionally does nothing on the network: it copies the app,
; the embedded Python runtime, writes shortcuts and an uninstaller. All heavy
; downloads (FFmpeg, PyTorch/audio-separator stack) happen inside the app on
; first launch, behind the explicit "Download & install" consent screen.
;
; The embedded runtime at embedded\runtime\ is prebuilt, not fetched by this
; script: embeddable Python 3.11.9 (python.org) with pip bootstrapped via
; get-pip.py and `pip install pywebview` run against it. Rebuild it with:
;   curl -o embedded\python-embed.zip https://www.python.org/ftp/python/3.11.9/python-3.11.9-embed-amd64.zip
;   (extract to embedded\runtime\, then edit python311._pth to read:
;      python311.zip
;      .
;      Lib\site-packages
;      ..
;
;      import site
;    — the blank "..":  sound_razor/ and ui_entrypoint.py are installed as
;    runtime\'s SIBLINGS ($INSTDIR, not $INSTDIR\runtime), and embeddable
;    Python otherwise only searches its own folder + site-packages, so
;    `import sound_razor` fails with ModuleNotFoundError without it —
;    this broke every installed copy until caught by actually running the
;    real installed exe, not just testing against a dev venv that already
;    had the package pip-installed.
;    Then: runtime\python.exe get-pip.py && runtime\python.exe -m pip install pywebview)
; No nsisunz or other plugin is needed — File /r just copies the folder as-is.
;
; Installs to Program Files for all users, so it needs administrator rights
; (the UAC prompt on launch) — a deliberate change from the earlier per-user,
; no-elevation design. The desktop shortcut is a user choice on its own page;
; the Start Menu entry and uninstaller are always created.

!include "MUI2.nsh"

!define NAME "Unweave"
!define VERSION "1.3.0"
!define PACKAGE_NAME "Unweave-Setup-x64"
!define REG_KEY "Software\Microsoft\Windows\CurrentVersion\Uninstall\${NAME}"
; The app was called SoundRazer Desktop up to 1.2.2 (see .onInit).
!define LEGACY_NAME "SoundRazer Desktop"
!define LEGACY_REG_KEY "Software\Microsoft\Windows\CurrentVersion\Uninstall\${LEGACY_NAME}"
!define ICON "..\assets\icon.ico"

!define MUI_ICON "${ICON}"
!define MUI_UNICON "${ICON}"

Name "${NAME} ${VERSION}"
OutFile "..\dist\${PACKAGE_NAME}.exe"
InstallDir "$PROGRAMFILES64\${NAME}"
RequestExecutionLevel admin
ShowInstDetails show
CRCCheck on

!insertmacro MUI_PAGE_DIRECTORY
!insertmacro MUI_PAGE_COMPONENTS
!insertmacro MUI_PAGE_INSTFILES

!insertmacro MUI_UNPAGE_INSTFILES

!insertmacro MUI_LANGUAGE "English"

; Replace a pre-rename install: move its data folder to the new name first (so the old
; uninstaller can't delete setup's ~1.6 GB of packages and nothing is downloaded again),
; then run the old uninstaller silently. Songs live in Documents and are never touched.
Function .onInit
  SetRegView 64
  ReadRegStr $0 HKLM "${LEGACY_REG_KEY}" "UninstallString"
  StrCmp $0 "" legacy_done
  ReadRegStr $1 HKLM "${LEGACY_REG_KEY}" "InstallLocation"
  MessageBox MB_OKCANCEL|MB_ICONINFORMATION "${NAME} is the new name of ${LEGACY_NAME}.$\n$\nThe old version will be removed first. Your songs, settings and downloaded components are kept." /SD IDOK IDOK legacy_remove
  Abort
  legacy_remove:
  IfFileExists "$LOCALAPPDATA\${NAME}\*.*" legacy_uninstall
  Rename "$LOCALAPPDATA\${LEGACY_NAME}" "$LOCALAPPDATA\${NAME}"
  legacy_uninstall:
  ExecWait '$0 /S _?=$1'
  ; _?= keeps the old uninstaller in place so ExecWait can wait for it; tidy what it leaves.
  Delete "$1\Uninstall.exe"
  RMDir /r "$1\__pycache__"
  RMDir "$1"
  legacy_done:
FunctionEnd

Section "${NAME}" SecMain
  SectionIn RO
  SetRegView 64
  SetOutPath "$INSTDIR"
  ; Local dev leftovers in app\ (bytecode caches, the editable install's egg-info) never ship.
  File /r /x __pycache__ /x *.egg-info "..\app\*"
  File "..\pyproject.toml"
  File "..\README.md"
  File "..\LICENSE"
  File "${ICON}"

  ; Embedded Python runtime with pywebview pre-installed (see header comment).
  SetOutPath "$INSTDIR\runtime"
  File /r "embedded\runtime\*"
  ; Puts setup's packages (%LOCALAPPDATA%\Unweave\packages) on the runtime's sys.path and
  ; keeps the shared per-user site-packages out (prepare_embedded_runtime in sound_razor/tools.py).
  SetOutPath "$INSTDIR\runtime\Lib\site-packages"
  File "unweave.pth"
  SetOutPath "$INSTDIR"

  ; Start Menu entry. Launches via launch.bat (app\launch.bat, copied in by the
  ; File /r above) rather than runtime\python.exe or pythonw.exe directly: on a real
  ; install, a shortcut launching python.exe straight (a fresh, attached console)
  ; reliably crashed within a second of opening, silently, every time; the exact
  ; same command with stdout/stderr redirected to a file instead — which is exactly
  ; what launch.bat does — opened the app successfully, every time. Root cause not
  ; understood; this is the configuration confirmed working on a real machine.
  ; File /r "..\app\*" copies app/'s CONTENTS into $INSTDIR directly (not into an
  ; "$INSTDIR\app" subfolder), so launch.bat/ui_entrypoint.py land at $INSTDIR's root.
  CreateDirectory "$SMPROGRAMS\${NAME}"
  CreateShortCut "$SMPROGRAMS\${NAME}\${NAME}.lnk" "$INSTDIR\launch.bat" "" "$INSTDIR\icon.ico"
  CreateShortCut "$SMPROGRAMS\${NAME}\Uninstall.lnk" "$INSTDIR\Uninstall.exe"

  WriteUninstaller "$INSTDIR\Uninstall.exe"

  ; Add/Remove Programs entry (HKLM — this is now a machine-wide Program Files install).
  WriteRegStr HKLM "${REG_KEY}" "DisplayName" "${NAME} ${VERSION}"
  WriteRegStr HKLM "${REG_KEY}" "UninstallString" '"$INSTDIR\Uninstall.exe"'
  WriteRegStr HKLM "${REG_KEY}" "DisplayIcon" "$INSTDIR\icon.ico"
  WriteRegStr HKLM "${REG_KEY}" "Publisher" "um1chc5"
  WriteRegStr HKLM "${REG_KEY}" "InstallLocation" "$INSTDIR"
  WriteRegDWORD HKLM "${REG_KEY}" "VersionMajor" 1
  WriteRegDWORD HKLM "${REG_KEY}" "VersionMinor" 3
  WriteRegDWORD HKLM "${REG_KEY}" "NoModify" 1
  WriteRegDWORD HKLM "${REG_KEY}" "NoRepair" 1
SectionEnd

Section "Desktop shortcut" SecDesktop
  CreateShortCut "$DESKTOP\${NAME}.lnk" "$INSTDIR\launch.bat" "" "$INSTDIR\icon.ico"
SectionEnd

!insertmacro MUI_FUNCTION_DESCRIPTION_BEGIN
!insertmacro MUI_DESCRIPTION_TEXT ${SecMain} "The app itself, its embedded Python runtime, a Start Menu entry and an uninstaller. Always installed."
!insertmacro MUI_DESCRIPTION_TEXT ${SecDesktop} "Add an ${NAME} icon to your desktop."
!insertmacro MUI_FUNCTION_DESCRIPTION_END

Section "Uninstall"
  SetRegView 64
  Delete "$INSTDIR\Uninstall.exe"
  Delete "$INSTDIR\pyproject.toml"
  Delete "$INSTDIR\README.md"
  Delete "$INSTDIR\LICENSE"
  Delete "$INSTDIR\icon.ico"
  Delete "$INSTDIR\ui_entrypoint.py"
  Delete "$INSTDIR\launch.bat"
  RMDir /r "$INSTDIR\sound_razor"
  RMDir /r "$INSTDIR\__pycache__"
  RMDir /r "$INSTDIR\unweave.egg-info"
  RMDir /r "$INSTDIR\soundrazer_desktop.egg-info"
  RMDir /r "$INSTDIR\runtime"
  RMDir "$INSTDIR"
  Delete "$SMPROGRAMS\${NAME}\${NAME}.lnk"
  Delete "$SMPROGRAMS\${NAME}\Uninstall.lnk"
  RMDir "$SMPROGRAMS\${NAME}"
  Delete "$DESKTOP\${NAME}.lnk"
  DeleteRegKey HKLM "${REG_KEY}"

  ; What first-run setup downloaded into the per-user app data folder is part of the
  ; app, so it always goes. Models and settings are the user's call (kept on /S);
  ; separated songs live in Documents and are never touched.
  RMDir /r "$LOCALAPPDATA\${NAME}\packages"
  RMDir /r "$LOCALAPPDATA\${NAME}\ffmpeg"
  MessageBox MB_YESNO|MB_ICONQUESTION|MB_DEFBUTTON2 "Also delete the downloaded AI models (~500 MB) and app settings?$\n$\nYour separated songs are not affected." /SD IDNO IDNO keep_data
    RMDir /r "$LOCALAPPDATA\${NAME}\models"
    Delete "$LOCALAPPDATA\${NAME}\ui.json"
    Delete "$LOCALAPPDATA\${NAME}\launch.log"
  keep_data:
  RMDir "$LOCALAPPDATA\${NAME}"
SectionEnd
