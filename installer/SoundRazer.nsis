; SoundRazer Desktop — NSIS installer (user-level, no wizard)
;
; Build: makensis SoundRazer.nsis
;
; This installer intentionally does nothing on the network: it copies the app,
; the embedded Python runtime, writes shortcuts and an uninstaller. All heavy
; downloads (FFmpeg, PyTorch/audio-separator stack) happen inside the app on
; first launch, behind the explicit "Download & install" consent screen.
;
; The embedded runtime at embedded\runtime\ is prebuilt, not fetched by this
; script: embeddable Python 3.11.9 (python.org) with pip bootstrapped via
; get-pip.py and `pip install pywebview` run against it. Rebuild it with:
;   curl -o embedded\python-embed.zip https://www.python.org/ftp/python/3.11.9/python-3.11.9-embed-amd64.zip
;   (extract to embedded\runtime\, uncomment "import site" in python311._pth,
;    add "Lib\site-packages" to it, then: runtime\python.exe get-pip.py &&
;    runtime\python.exe -m pip install pywebview)
; No nsisunz or other plugin is needed — File /r just copies the folder as-is.

!include "MUI2.nsh"

!define NAME "SoundRazer Desktop"
!define VERSION "1.0.0"
!define PACKAGE_NAME "SoundRazer-Setup-x64"
!define REG_KEY "Software\Microsoft\Windows\CurrentVersion\Uninstall\${NAME}"

Name "${NAME} ${VERSION}"
OutFile "..\dist\${PACKAGE_NAME}.exe"
InstallDir "$LOCALAPPDATA\SoundRazer Desktop"
RequestExecutionLevel user
ShowInstDetails show
CRCCheck on

; One page only: pick the destination folder (default %LOCALAPPA data%\SoundRazer Desktop),
; then installation runs immediately. No license, components, ready or finish checkboxes.
!insertmacro MUI_PAGE_DIRECTORY
!insertmacro MUI_PAGE_INSTFILES

!insertmacro MUI_UNPAGE_INSTFILES

!insertmacro MUI_FUNCTION_DESCRIPTION_BEGIN
!insertmacro MUI_DESCRIPTION_TEXT ${MUI_PAGE_DIRECTORY} "Choose where SoundRazer Desktop is installed. Anything user-writable works; no administrator elevation is required."
!insertmacro MUI_DESCRIPTION_TEXT ${MUI_PAGE_INSTFILES} "Copying app files and embedded runtime. Nothing downloads from the network during install."
!insertmacro MUI_FUNCTION_DESCRIPTION_END

!insertmacro MUI_LANGUAGE "English"

Section "Install"
  SetOutPath "$INSTDIR"
  File /r "..\app\*"
  File "..\pyproject.toml"
  File "..\README.md"
  File "..\LICENSE"

  ; Embedded Python runtime with pywebview pre-installed (see header comment).
  SetOutPath "$INSTDIR\runtime"
  File /r "embedded\runtime\*"
  SetOutPath "$INSTDIR"

  ; Shortcuts: embedded pythonw.exe runs the app window, no console.
  ; File /r "..\app\*" copies app/'s CONTENTS into $INSTDIR directly (not into an
  ; "$INSTDIR\app" subfolder), so ui_entrypoint.py lands at $INSTDIR's root.
  CreateShortCut "$SMPROGRAMS\${NAME}.lnk" "$INSTDIR\runtime\pythonw.exe" "$INSTDIR\ui_entrypoint.py" "$INSTDIR\runtime\python.exe" 0
  CreateShortCut "$DESKTOP\${NAME}.lnk" "$INSTDIR\runtime\pythonw.exe" "$INSTDIR\ui_entrypoint.py" "$INSTDIR\runtime\python.exe" 0

  WriteUninstaller "$INSTDIR\Uninstall.exe"

  ; Add/Remove Programs entry (HKCU — writable without elevation).
  WriteRegStr HKCU "${REG_KEY}" "DisplayName" "${NAME} ${VERSION}"
  WriteRegStr HKCU "${REG_KEY}" "UninstallString" '"$INSTDIR\Uninstall.exe"'
  WriteRegStr HKCU "${REG_KEY}" "DisplayIcon" "$INSTDIR\runtime\python.exe"
  WriteRegStr HKCU "${REG_KEY}" "Publisher" "SoundRazer Team"
  WriteRegStr HKCU "${REG_KEY}" "InstallLocation" "$INSTDIR"
  WriteRegDWORD HKCU "${REG_KEY}" "VersionMajor" 1
  WriteRegDWORD HKCU "${REG_KEY}" "VersionMinor" 0
SectionEnd

Section "Uninstall"
  Delete "$INSTDIR\Uninstall.exe"
  Delete "$INSTDIR\pyproject.toml"
  Delete "$INSTDIR\README.md"
  Delete "$INSTDIR\LICENSE"
  Delete "$INSTDIR\ui_entrypoint.py"
  RMDir /r "$INSTDIR\sound_razor"
  RMDir /r "$INSTDIR\soundrazer_desktop.egg-info"
  RMDir /r "$INSTDIR\runtime"
  Delete "$SMPROGRAMS\${NAME}.lnk"
  Delete "$DESKTOP\${NAME}.lnk"
  DeleteRegKey HKCU "${REG_KEY}"
SectionEnd
